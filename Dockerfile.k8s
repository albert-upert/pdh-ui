# Build context: project root directory
# docker build -f Dockerfile.k8s .

# ── Build stage ───────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder

RUN npm install -g pnpm@10.33.2

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc ./

RUN pnpm install --frozen-lockfile

COPY . .

RUN pnpm run build-storybook

# ── Production stage ──────────────────────────────────────────────────────────
FROM nginx:alpine

# The base image can lag behind Alpine's security fixes (brotli, curl, expat): take them at build time.
RUN apk upgrade --no-cache

COPY --from=builder /app/storybook-static /app/storybook-static
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 4000

CMD ["nginx", "-g", "daemon off;"]
